{
  "name": "limelight-webapp",
  "version": "3.0.0",
  "private": true,
  "description": "Limelight Workspace: Next.js frontend (View) + Express/Node.js MVC backend",
  "main": "api/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "next dev",
    "dev:api": "node --watch backend/server.js",
    "build": "next build",
    "start": "next start",
    "start:api": "node backend/server.js",
    "lint": "next lint",
    "test": "node backend/tests/test_api.js",
    "test:security": "node backend/tests/test_security.js",
    "test:all": "node backend/tests/test_api.js && node backend/tests/test_security.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
