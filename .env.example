PORT=5000
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=365d

# ---- Data: Supabase Postgres (required in production) ----------------------------
# Supabase -> Connect -> Connection string -> URI (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Without DATABASE_URL the API falls back to a local SQLite file with demo data:
# DATABASE_PATH=backend/database/limelight.db

# ---- Logins: Supabase Auth ---------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# Server-only. Needed so admins can add staff (creates the Supabase Auth login), change passwords, remove staff.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
# Emails that always get admin access (comma separated)
ADMIN_EMAILS=admin@limelight.in
# Password given to staff added without one
DEFAULT_STAFF_PASSWORD=Limelight@123

# Simran assistant (optional)
ANTHROPIC_API_KEY=
# WhatsApp Cloud API (optional; without these the app opens a wa.me link instead)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# AI Agent page (prompts, content, scripts, schedule, ads). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# PPT tab -> Google Slides. Google Cloud service account key (paste the JSON on one line, or base64 of it).
# Enable "Google Slides API" and "Google Drive API" on the project. Without this the tab returns a .pptx download.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: a Drive folder shared (Editor) with the service account email, so decks land in the team Drive.
GOOGLE_DRIVE_FOLDER_ID=
