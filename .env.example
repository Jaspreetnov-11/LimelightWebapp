PORT=5000
NODE_ENV=development
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Data: Supabase Postgres (required in production) ----------------------------
# Supabase -> Connect -> Connection string -> URI (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Without DATABASE_URL the API falls back to a local SQLite file with demo data:
# DATABASE_PATH=backend/database/limelight.db

# ---- Logins: Supabase Auth ---------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# Server-only. Needed so admins can add staff (creates the Supabase Auth login), change passwords, remove staff.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
# Emails that always get admin access (comma separated)
ADMIN_EMAILS=admin@limelight.in
# Password given to staff added without one
DEFAULT_STAFF_PASSWORD=Limelight@123
